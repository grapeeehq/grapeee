{
  "name": "grapeee",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "lint:web": "bun run --cwd apps/web lint",
    "dev:api": ". .venv/bin/activate && uvicorn app.main:app --reload --app-dir apps/api",
    "test:api": ". .venv/bin/activate && pytest apps/api/tests",
    "format:api": ". .venv/bin/activate && ruff format apps/api && ruff check --fix apps/api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}

