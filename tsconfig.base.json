{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@grapeee/shared-types": [
        "./packages/shared-types/src/index.ts"
      ],
      "@grapeee/roblox-context": [
        "./packages/roblox-context/src/index.ts"
      ],
      "@grapeee/knowledge-system": [
        "./packages/knowledge-system/src/index.ts"
      ],
      "@grapeee/agent-core": [
        "./packages/agent-core/src/index.ts"
      ]
    }
  }
}
